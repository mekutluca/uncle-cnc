# Supabase — ilanlar (anon, salt-okunur RLS) + yönetim paneli oturumu.
# Anon anahtar tasarım gereği herkese açıktır (publishable); RLS esas güvenlik katmanıdır.
PUBLIC_SUPABASE_URL=https://ulrnpomzasifmcebgngy.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Form bildirimi e-postası — Brevo SMTP relay (boş bırakılırsa bildirim atlanır,
# kayıt yine Supabase'e düşer). Kimlik bilgileri: Brevo → Settings → SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Brevo SMTP_USER hesap login'idir (ör. 7xxxxx001@smtp-brevo.com); gönderen adresi
# ayrıca gerekir ve doğrulanmış bir domain'de olmalıdır. Alıcı varsayılanı info@unclecnc.com.
SMTP_FROM=no-reply@unclecnc.com
FORM_NOTIFY_TO=
